# Telegram bot token from @BotFather. Without it the bot cannot deliver
# alerts; the pipeline still runs and `npm run dry-run` prints alerts to the
# console from live chain data.
TELEGRAM_BOT_TOKEN=

# Optional public channel that mirrors the alert feed at the default
# sensitivity (@name or -100... id). The bot must be a channel admin with
# permission to post.
# TELEGRAM_CHANNEL_ID=

# Optional custom RPC endpoint. Defaults to the public Robinhood Chain RPC
# (https://rpc.mainnet.chain.robinhood.com) from viem's chain definition.
# RPC_URL=

# SQLite database file. The directory is created if missing.
# DB_PATH=./data/volume-alerts.db

# Trailing window (minutes) a token's "normal" per-minute volume is learned
# from. Default 60.
# BASELINE_MINUTES=60

# How often the rolling 60s window is evaluated, in seconds. Default 15.
# EVAL_INTERVAL_S=15

# Per-chat cooldown between two alerts for the same token, in minutes.
# Default 30.
# COOLDOWN_MINUTES=30

# How much history to backfill on startup so baselines are warm from the
# first evaluation, in minutes. Default 70.
# BACKFILL_MINUTES=70

# pino log level: trace | debug | info | warn | error. Default info.
# LOG_LEVEL=info
